# Local CPU embedding/reranker; Ollama uses available GPU memory.
DATA_DIR=./data
MODEL_CACHE=./models
QDRANT_URL=
QDRANT_COLLECTION=knowledge_bge_m3_v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=4
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=2
RERANKER_MAX_LENGTH=1200
# Download once with scripts/download_models.py; runtime is offline by default.
MODELS_LOCAL_ONLY=true
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=knowledge-qwen3:8b
# Ollama thinking control; leave empty for servers that do not support this field.
LLM_REASONING_EFFORT=none
LLM_CONTEXT_TOKENS=8192
LLM_MAX_TOKENS=768
LLM_TIMEOUT_SECONDS=180
ALLOW_REMOTE_ENDPOINTS=false
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=30
RERANK_TOP_K=5
# Empirical starting threshold, not a calibrated probability; tune on your documents.
MIN_RERANK_SCORE=0.15
MAX_UPLOAD_MB=25
MAX_PARSED_CHARS=2000000
MAX_PDF_PAGES=500
RAG_DEBUG=false
